{
  "name": "mms-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend foundation for the Madrasa Management System",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:e2e-roles": "tsx scripts/seed-e2e-roles.ts",
    "payments:reconcile": "tsx scripts/reconcile-pending-payments.ts",
    "smoke:core": "bash scripts/smoke-core-flow.sh",
    "smoke:write": "bash scripts/smoke-write-flow.sh",
    "smoke:public-inquiry": "bash scripts/smoke-public-inquiry-flow.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.8.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.53.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pdfkit": "^0.20.2",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.15.30",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.0",
    "prisma": "^6.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
