# Deployment target: afaq.africa. This file does not provision DNS or email.
# Supply secrets through the deployment environment; never commit real values.
NODE_ENV=production
APP_NAME=Afaq
PORT=4000
TZ=Africa/Dar_es_Salaam
APP_BASE_URL="https://api.afaq.africa"
WEB_APP_ORIGINS="https://afaq.africa"
# Set the actual organization code before enabling public registration.
PUBLIC_SITE_ORG_CODE=""

DATABASE_URL=""
REDIS_URL=""
JWT_SECRET=""
JWT_REFRESH_SECRET=""
PLATFORM_JWT_SECRET=""
PLATFORM_MFA_ENCRYPTION_KEY=""
ALLOW_PLATFORM_BOOTSTRAP="false"

SNIPPE_BASE_URL="https://api.snippe.sh"
SNIPPE_API_KEY=""
SNIPPE_WEBHOOK_SECRET=""
SNIPPE_MOCK_MODE="false"

# Planned sender only; the SMTP adapter is not connected to automatic notifications.
# Keep disabled until sender/recipient verification and delivery integration exist.
EMAIL_MODE="disabled"
SCHOOL_INVITATIONS_ENABLED="false"
SCHOOL_INVITATION_URL="https://your-afaq-domain.example/#/school-invitation"
EMAIL_CAPTURE_DIR=""
EMAIL_FROM="noreply@afaq.africa"
EMAIL_LOGIN_URL="https://afaq.africa/#/login"
# Reserved mailbox setting for future support integration; not consumed by API yet.
EMAIL_SUPPORT_ADDRESS="support@afaq.africa"
# IT confirms sender ownership only after verification with the chosen provider.
EMAIL_SENDER_VERIFIED="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Quran Foundation: backend-only credentials. Enable after provider setup.
# Production requires approved access and matching production credentials.
QF_ENABLED="false"
QF_ENV="prelive"
QF_CLIENT_ID=
QF_CLIENT_SECRET=
# Meseji SMS. Apply the donation_sms migration before enabling receipt notifications.
SMS_ENABLED="false"
DONATION_SMS_ENABLED="false"
DONOR_MANUAL_SMS_ENABLED="false"
SMS_PROVIDER="meseji"
# Alternatively use SMS_PROVIDER="rodsms". Sender ID must be approved by RodSMS.
RODSMS_API_KEY=""
RODSMS_SENDER_ID="AFAQ"
RODSMS_BASE_URL="https://www.rodsms.com/api/v1"
MESEJI_BASE_URL="https://meseji.co.tz/api/v1"
MESEJI_API_KEY=""
# Sender ID approved in the Meseji dashboard.
MESEJI_SENDER_ID=""

